[Unit]
Description=Send Firefly monthly hours request
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
ExecStart=%h/.local/bin/eom-mail-watch send-hours
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/eom-email-watcher
