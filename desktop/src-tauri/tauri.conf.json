{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Email Watcher",
  "version": "0.1.0",
  "identifier": "com.canfieldjuan.email-watcher",
  "build": {
    "beforeDevCommand": "pnpm build:sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Email Watcher",
        "width": 920,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "externalBin": ["binaries/eom-mail-engine"],
    "icon": ["icons/icon.png"]
  }
}
